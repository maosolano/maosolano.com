---
import Nav from "@/components/Nav.astro";
import LangSwitch from "@/components/LangSwitch.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Mao Solano — UX, AI, and digital product design." } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Mao Solano</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Nav>
      <LangSwitch slot="lang-switch" />
    </Nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Mao Solano</p>
    </footer>
  </body>
</html>

<style>
  main {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8) var(--space-6);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
