---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Prose from "@/components/Prose.astro";
import Carousel from "@/components/Carousel.astro";
import Recommendation from "@/components/Recommendation.astro";
import { recommendations } from "@/i18n/ui";
import { getEntry } from "astro:content";

const sample = await getEntry("projects", "es/matcha");

const colors = [
  ["--color-bg", "--white", "Fondo de página"],
  ["--color-surface", "--slate-50", "Superficies sobre el fondo"],
  ["--color-border", "--slate-300", "Bordes y separadores"],
  ["--color-border-subtle", "--slate-100", "Separadores internos"],
  ["--color-text", "--slate-900", "Texto principal"],
  ["--color-heading", "--slate-800", "Todos los encabezados, h1 a h6"],
  ["--color-text-muted", "--slate-500", "Texto secundario, fechas"],
  ["--color-underline", "--slate-900", "Subrayado de enlaces y filetes de énfasis"],
  ["--color-accent", "--lime-500", "Relleno: hover, resaltado, estado activo"],
  ["--color-accent-strong", "--lime-400", "Relleno en hover de botones"],
  ["--color-focus", "--slate-900", "Anillo de foco"],
];

const typeScale = [
  ["--text-3xl", "3rem", "Display (home)"],
  ["--text-2xl", "2.25rem", "h1"],
  ["--text-xl", "1.75rem", "h2"],
  ["--text-lg", "1.375rem", "h3, lead, títulos de tarjeta"],
  ["--text-base", "1.125rem", "Cuerpo"],
  ["--text-sm", "0.9375rem", "Fechas, metadatos, pie"],
  ["--text-xs", "0.8125rem", "Etiquetas en mayúsculas"],
];

const spacing = [1, 2, 3, 4, 5, 6, 7, 8];
---

<Layout
  pageKey="styleguide"
  title="Styleguide"
  description="Referencia interna del sistema de diseño."
  noindex
>
  <h1>Styleguide</h1>
  <p class="intro">
    Referencia del sistema de diseño. No está en el menú y no se indexa.
    Las reglas completas están en <code>DESIGN.md</code>.
  </p>

  <!-- Colour -->
  <section>
    <h2>Color</h2>
    <p class="note">
      Los componentes usan solo los nombres semánticos de la izquierda.
      El lima es solo relleno: nunca texto ni líneas, porque sobre el fondo claro
      apenas se distingue (1.2:1). Con tinta encima llega a 13:1.
    </p>
    <ul class="swatches">
      {colors.map(([semantic, base, use]) => (
        <li class="swatch">
          <span class="swatch__chip" style={`background-color: var(${semantic})`}></span>
          <code class="swatch__name">{semantic}</code>
          <code class="swatch__base">{base}</code>
          <span class="swatch__use">{use}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Type -->
  <section>
    <h2>Tipografía</h2>
    <p class="note">
      Space Grotesk para todo (400, 500 y 700). No tiene cursiva real:
      el énfasis va con peso, no con oblicua. Los títulos van en minúsculas
      de oración; las mayúsculas quedan para las etiquetas.
    </p>
    <ul class="type">
      {typeScale.map(([token, size, use]) => (
        <li class="type__row">
          <span class="type__sample" style={`font-size: var(${token})`}>Mao Solano</span>
          <span class="type__meta"><code>{token}</code> · {size} · {use}</span>
        </li>
      ))}
      <li class="type__row">
        <span class="type__sample type__sample--body">
          Cuerpo en Space Grotesk a 18px, interlínea 1.6.
        </span>
        <span class="type__meta"><code>--font-sans</code></span>
      </li>
    </ul>
  </section>

  <!-- Spacing -->
  <section>
    <h2>Espaciado</h2>
    <ul class="space">
      {spacing.map((n) => (
        <li class="space__row">
          <code>--space-{n}</code>
          <span class="space__bar" style={`width: var(--space-${n})`}></span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Links and buttons -->
  <section>
    <h2>Enlaces y botones</h2>
    <p class="note">
      El enlace es texto tinta con subrayado tinta grueso. En hover el
      lima pasa a ser el fondo. El botón solo existe en el menú móvil.
    </p>
    <p><a href="/styleguide">Enlace en párrafo</a> dentro de una línea de texto.</p>
    <p class="demo">
      <button type="button" class="demo__button">
        Botón
        <span class="demo__icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </p>
  </section>

  <!-- Project card -->
  <section>
    <h2>ProjectCard</h2>
    {sample && (
      <ProjectCard
        title={sample.data.title}
        url={sample.data.url}
        image={sample.data.image}
        imageAlt="Captura de pantalla del proyecto"
        visitLabel="Ver el sitio"
      >
        <p>{sample.data.summary}</p>
      </ProjectCard>
    )}
    {sample && (
      <div style="max-width: 320px; margin-top: var(--space-6)">
        <ProjectCard
          title={sample.data.title}
          url={sample.data.url}
          image={sample.data.image}
          imageAlt="Captura de pantalla del proyecto"
          visitLabel="Conocer detalles"
          layout="tile"
        >
          <p>{sample.data.summary}</p>
        </ProjectCard>
      </div>
    )}
  </section>

  <!-- Carousel + Recommendation -->
  <section>
    <h2>Carousel y Recommendation</h2>
    <p class="note">
      Carrusel horizontal con scroll nativo y snap; los botones solo aparecen con
      JavaScript. Cada tarjeta es una recomendación de LinkedIn: si el texto es una
      traducción, el original queda dentro de un <code>details</code>.
    </p>
    <Carousel label="Recomendaciones" prevLabel="Anterior" nextLabel="Siguiente">
      {recommendations.map((rec) => (
        <Recommendation
          quote={rec.quote.es}
          name={rec.name}
          role={rec.role}
          org={rec.org}
          relation={rec.relation.es}
          original={rec.lang === "es" ? undefined : { lang: rec.lang, quote: rec.quote[rec.lang] }}
          originalLabel="Traducido del inglés. Ver el original"
        />
      ))}
    </Carousel>
  </section>

  <!-- Prose -->
  <section>
    <h2>Prose</h2>
    <p class="note">Contenedor de los posts del Lab.</p>
    <Prose>
      <h2>Un título dentro del post</h2>
      <p>
        Párrafo de ejemplo con el ancho de lectura del Lab. El contenedor limita
        la medida a 68 caracteres para que la línea no se alargue de más.
      </p>
      <blockquote>Una cita, marcada con una barra amarilla a la izquierda.</blockquote>
      <ul>
        <li>Elemento de lista</li>
        <li>Otro elemento</li>
      </ul>
    </Prose>
  </section>
</Layout>

<style>
  .intro,
  .note {
    max-width: 62ch;
    color: var(--color-text-muted);
  }

  .intro {
    margin-top: var(--space-4);
  }

  section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }

  section h2 {
    margin-bottom: var(--space-4);
  }

  .note {
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
  }

  code {
    font-size: var(--text-sm);
  }

  /* Colour */
  .swatches {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .swatch {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }

  .swatch + .swatch {
    margin-top: 0;
  }

  .swatch__chip {
    grid-row: span 3;
    width: 48px;
    height: 48px;
    border: var(--border-width) solid var(--color-border);
  }

  .swatch__base,
  .swatch__use {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Type */
  .type,
  .space {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .type__row {
    padding: var(--space-3) 0;
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }

  .type__row + .type__row {
    margin-top: 0;
  }

  .type__sample {
    display: block;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-h2);
    line-height: var(--leading-title);
  }

  .type__sample--body {
    font-weight: var(--weight-regular);
    letter-spacing: normal;
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  .type__meta {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Spacing */
  .space__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) 0;
  }

  .space__row + .space__row {
    margin-top: 0;
  }

  .space__row code {
    width: 90px;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .space__bar {
    height: 12px;
    background-color: var(--color-accent);
  }

  /* Button demo — mirrors the mobile menu toggle */
  .demo {
    margin-top: var(--space-4);
  }

  .demo__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-3);
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .demo__button:hover {
    background-color: var(--color-accent);
  }

  .demo__icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }

  .demo__icon > span {
    display: block;
    height: var(--border-width);
    background-color: var(--color-text);
  }
</style>
