---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection, render } from "astro:content";
import { useTranslations } from "@/i18n/ui";

const lang = "es" as const;
const t = useTranslations(lang);

const entries = (await getCollection("projects", ({ id }) => id.startsWith("es/"))).sort(
  (a, b) => a.data.order - b.data.order
);

const projects = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Layout pageKey="projects" title={t("projects.title")} description={t("projects.description")}>
  <h1>{t("projects.title")}</h1>

  <div class="list">
    {projects.map(({ entry, Content }) => (
      <ProjectCard
        title={entry.data.title}
        url={entry.data.url}
        image={entry.data.image}
        imageAlt={t("projects.imageAlt")}
        visitLabel={t("projects.visit")}
        layout="stacked"
      >
        <Content />
      </ProjectCard>
    ))}
  </div>
</Layout>

<style>
  .list {
    margin-top: var(--space-7);
  }
</style>
