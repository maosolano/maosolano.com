---
import Layout from "@/layouts/Layout.astro";
import PostList from "@/components/PostList.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "@/i18n/ui";

const lang = "en" as const;
const t = useTranslations(lang);

const posts = (
  await getCollection("lab", ({ id, data }) => id.startsWith("en/") && !data.draft)
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    href: `/en/lab/${post.id.replace(/^en\//, "")}`,
    title: post.data.title,
    date: post.data.date,
    summary: post.data.summary,
  }));
---

<Layout pageKey="lab" title={t("lab.title")} description={t("lab.description")}>
  <h1>{t("lab.title")}</h1>

  <div class="list">
    <PostList posts={posts} lang={lang} emptyLabel={t("lab.empty")} />
  </div>
</Layout>

<style>
  .list {
    margin-top: var(--space-6);
  }
</style>
