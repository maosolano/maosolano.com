---
import Layout from "@/layouts/Layout.astro";
import { useTranslations, EMAIL, LINKEDIN } from "@/i18n/ui";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout pageKey="contact" title={t("contact.title")} description={t("contact.description")}>
  <h1>{t("contact.title")}</h1>

  <dl class="contact">
    <dt>{t("contact.email")}</dt>
    <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>

    <dt>{t("contact.linkedin")}</dt>
    <dd><a href={LINKEDIN}>linkedin.com/in/maosolano</a></dd>
  </dl>
</Layout>

<style>
  .contact {
    margin-top: var(--space-6);
  }

  .contact dt {
    font-family: var(--font-title);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-5);
  }

  .contact dd {
    margin-top: var(--space-1);
  }
</style>
