---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { projectPath, projectSlug, useTranslations, profile } from "@/i18n/ui";

const lang = "en" as const;
const t = useTranslations(lang);

const projects = (await getCollection("projects", ({ id }) => id.startsWith("en/"))).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout pageKey="home" description={t("home.description")}>
  <h1 class="tagline">{t("home.tagline")}</h1>

  <div class="profile">
    {profile[lang].map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <p class="personal"><em>{t("home.personal")}</em></p>

  <h2 class="section">{t("home.recent")}</h2>

  {projects.map((project) => (
    <ProjectCard
      title={project.data.title}
      url={project.data.url}
      href={projectPath(lang, projectSlug(project.id))}
      image={project.data.image}
      imageAlt={t("projects.imageAlt")}
      visitLabel={t("projects.visit")}
    >
      <p>{project.data.summary}</p>
    </ProjectCard>
  ))}
</Layout>

<style>
  .tagline {
    max-width: 20ch;
    margin-bottom: var(--space-6);
  }

  .profile {
    max-width: 62ch;
  }

  .profile p + p {
    margin-top: var(--space-4);
  }

  .personal {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    max-width: 62ch;
    color: var(--color-text-muted);
  }

  .section {
    margin-top: var(--space-8);
    margin-bottom: var(--space-6);
  }
</style>
