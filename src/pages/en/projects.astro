---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { projectPath, projectSlug, useTranslations } from "@/i18n/ui";

const lang = "en" as const;
const t = useTranslations(lang);

const entries = (await getCollection("projects", ({ id }) => id.startsWith("en/"))).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout pageKey="projects" title={t("projects.title")} description={t("projects.description")} wide>
  <h1>{t("projects.title")}</h1>

  <div class="grid">
    {entries.map((entry) => (
      <ProjectCard
        title={entry.data.title}
        url={entry.data.url}
        href={projectPath(lang, projectSlug(entry.id))}
        image={entry.data.image}
        imageAlt={t("projects.imageAlt")}
        visitLabel={t("projects.visit")}
        subtitle={entry.data.subtitle}
        layout="tile"
      >
        <p>{entry.data.summary}</p>
      </ProjectCard>
    ))}
  </div>
</Layout>

<style>
  /* Wide layout: the cards use the desktop width instead of the 720px text column. */
  .grid {
    max-width: 1280px;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    margin-top: var(--space-7);
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
