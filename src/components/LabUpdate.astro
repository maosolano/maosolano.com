---
/**
 * A dated update to a Lab post: a short summary of what changed since it was
 * written. Sits above the post, set apart from the prose.
 */
import { useTranslations, formatDate, type Lang } from "@/i18n/ui";

interface Props {
  date: Date;
  title: string;
  items: string[];
  lang: Lang;
}

const { date, title, items, lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="update">
  <p class="label">
    {t("lab.update")} · <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
  </p>
  <p class="title">{title}</p>
  <ul>
    {items.map((item) => <li set:html={item} />)}
  </ul>
</aside>

<style>
  .update {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-left: var(--space-2) solid var(--color-accent);
    background-color: var(--color-surface);
    max-width: 68ch;
  }

  .label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .title {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    font-weight: var(--weight-bold);
  }

  ul {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }

  li + li {
    margin-top: var(--space-2);
  }
</style>
