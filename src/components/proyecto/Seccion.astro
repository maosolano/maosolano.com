---
/** One section of a project page: numbered heading, one-line question, then its content. */
interface Props {
  id: string;
  title: string;
  lead?: string;
}

const { id, title, lead } = Astro.props;
---

<section class="seccion" id={id} aria-labelledby={`${id}-titulo`}>
  <h2 id={`${id}-titulo`}>{title}</h2>
  {lead && <p class="seccion__lead">{lead}</p>}
  <slot />
</section>

<style>
  .seccion {
    clear: both;
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    /* Anchors land below the site bar and the sticky project head. */
    scroll-margin-top: calc(var(--bar-height, 64px) + var(--head-height, 120px) + var(--space-4));
    border-top: var(--border-width) solid var(--color-border);
  }

  .seccion > :global(* + *) {
    margin-top: var(--space-5);
  }

  /* Running text keeps its reading width; schemes and screenshots use the full column. */
  .seccion > :global(p),
  .seccion > :global(ul:not(.enlaces)),
  .seccion > :global(h3),
  .seccion__lead {
    max-width: 68ch;
  }

  .seccion__lead {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
</style>
