---
import { getLangFromUrl, useTranslations, getLocalePath } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { key: "nav.projects" as const, path: lang === "es" ? "/proyectos" : "/en/projects" },
  { key: "nav.lab" as const, path: lang === "es" ? "/lab" : "/en/lab" },
  { key: "nav.about" as const, path: lang === "es" ? "/sobre-mi" : "/en/about" },
  { key: "nav.contact" as const, path: lang === "es" ? "/contacto" : "/en/contact" },
];

const homeHref = lang === "es" ? "/" : "/en";
---

<header class="nav-header">
  <nav class="nav" aria-label="Main navigation">
    <a href={homeHref} class="nav-logo" aria-label="Mao Solano — inicio">
      Mao Solano
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map(({ key, path }) => (
        <li>
          <a href={path} class:list={["nav-link", { active: Astro.url.pathname === path }]}>
            {t(key)}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-end">
      <slot name="lang-switch" />
      <button
        class="nav-hamburger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("nav.open")}
      >
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
      </button>
    </div>

    <div id="mobile-menu" class="nav-mobile" aria-hidden="true">
      <ul role="list">
        {navLinks.map(({ key, path }) => (
          <li>
            <a href={path} class="nav-mobile-link">
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--space-6);
    height: var(--nav-height);
  }

  .nav-logo {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin-right: auto;
  }

  .nav-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1);
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
    transition: transform var(--transition-base), opacity var(--transition-fast);
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }

    .nav-hamburger {
      display: flex;
    }

    .nav-mobile {
      position: fixed;
      inset: var(--nav-height) 0 0 0;
      background-color: var(--color-bg);
      padding: var(--space-8) var(--space-6);
      list-style: none;
      flex-direction: column;
      gap: var(--space-4);
    }

    .nav-mobile[aria-hidden="false"] {
      display: flex;
    }

    .nav-mobile-link {
      font-size: var(--text-xl);
      font-weight: var(--weight-medium);
      color: var(--color-text);
    }
  }

  .nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".nav-hamburger");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  btn?.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!expanded));
    menu?.setAttribute("aria-hidden", String(expanded));
  });
</script>
