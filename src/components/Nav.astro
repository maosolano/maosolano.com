---
import LangSwitch from "./LangSwitch.astro";
import {
  getLangFromUrl,
  useTranslations,
  navOrder,
  routes,
  type PageKey,
} from "@/i18n/ui";

interface Props {
  pageKey: PageKey;
  altHref: string;
}

const { pageKey, altHref } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="bar">
  <a href={routes[lang].home} class="brand">{t("site.name")}</a>

  <button
    type="button"
    class="toggle"
    aria-expanded="false"
    aria-controls="primary-menu"
  >
    <span class="toggle__text">{t("nav.toggle")}</span>
    <span class="toggle__icon" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
  </button>

  <nav id="primary-menu" class="menu" aria-label={t("nav.label")}>
    <ul class="menu__list">
      {navOrder.map((key) => {
        const current = key === pageKey;
        return (
          <li>
            <a
              href={routes[lang][key]}
              class:list={["menu__link", { "is-current": current }]}
              aria-current={current ? "page" : undefined}
            >
              {t(`nav.${key}`)}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="menu__lang">
      <LangSwitch altHref={altHref} />
    </div>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    background-color: var(--color-bg);
  }

  .brand {
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    line-height: var(--leading-title);
    text-decoration: none;
  }

  .brand:hover {
    background-color: var(--color-accent);
  }

  .menu {
    display: flex;
  }

  .menu__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
  }

  .menu__list li + li {
    margin-top: 0;
  }

  .menu__link {
    display: flex;
    align-items: center;
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
  }

  .menu__link:hover,
  .menu__link.is-current {
    background-color: var(--color-accent);
  }

  /* ---------- Desktop: one row, name left, menu right ---------- */
  @media (min-width: 800px) {
    .bar {
      position: sticky;
      top: 0;
      z-index: 100;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-4) var(--space-7);
      border-bottom: var(--border-width) solid var(--color-border);
    }

    .menu {
      align-items: center;
      gap: var(--space-4);
    }

    .menu__list {
      gap: var(--space-1);
    }

    .toggle {
      display: none;
    }
  }

  /* ---------- Mobile: top bar + panel ---------- */
  @media (max-width: 799px) {
    .bar {
      position: sticky;
      top: 0;
      z-index: 100;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
      border-bottom: var(--border-width) solid var(--color-border);
    }

    .toggle {
      display: none; /* only shown when JS is available */
      align-items: center;
      gap: var(--space-2);
      min-height: var(--tap-target);
      min-width: var(--tap-target);
      padding: var(--space-2) var(--space-3);
      background: none;
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius);
      font-weight: var(--weight-medium);
      font-size: var(--text-sm);
      color: var(--color-text);
      cursor: pointer;
    }

    .toggle:hover {
      background-color: var(--color-accent);
    }

    .toggle__icon {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 18px;
    }

    .toggle__icon > span {
      display: block;
      height: var(--border-width);
      background-color: var(--color-text);
    }

    .menu {
      width: 100%;
      flex-direction: column;
      padding-bottom: var(--space-3);
    }

    .menu__list {
      flex-direction: column;
    }

    .menu__link {
      min-height: var(--tap-target);
      font-size: var(--text-lg);
      padding: var(--space-2) var(--space-3);
      margin-left: calc(var(--space-3) * -1);
    }

    .menu__lang {
      margin-top: var(--space-3);
    }

    /* With JS the panel collapses behind the button.
       Without JS both stay visible, so the links remain reachable. */
    :global(html.js) .toggle {
      display: flex;
    }

    :global(html.js) .menu {
      display: none;
    }

    :global(html.js) .menu.is-open {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".toggle");
  const menu = document.querySelector<HTMLElement>("#primary-menu");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("is-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
