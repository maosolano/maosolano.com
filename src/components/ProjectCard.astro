---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  href: string;
  image?: string;
  year?: number;
}

const { title, description, tags = [], href, image, year } = Astro.props;
---

<article class="project-card">
  {image && (
    <a href={href} class="project-card__media" tabindex="-1" aria-hidden="true">
      <img src={image} alt="" width="800" height="450" loading="lazy" />
    </a>
  )}
  <div class="project-card__body">
    <div class="project-card__meta">
      {year && <span class="project-card__year">{year}</span>}
      {tags.length > 0 && (
        <ul class="project-card__tags" role="list">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}
    </div>
    <h2 class="project-card__title">
      <a href={href}>{title}</a>
    </h2>
    <p class="project-card__desc">{description}</p>
  </div>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    transition: border-color var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-text-muted);
  }

  .project-card__media img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .project-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .project-card__year {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .project-card__tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    list-style: none;
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 2px var(--space-2);
  }

  .project-card__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .project-card__title a {
    color: var(--color-text);
  }

  .project-card__title a:hover {
    color: var(--color-accent);
  }

  .project-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: none;
  }
</style>
