---
import { Image } from "astro:assets";

interface Props {
  title: string;
  url: string;
  image?: ImageMetadata;
  imageAlt: string;
  visitLabel: string;
  /**
   * "split" puts the image left and the text right — right for a one-line
   * summary. "stacked" gives both the full column width, which long bodies
   * need: at 40% of the content width the measure drops to ~33 characters.
   */
  layout?: "split" | "stacked";
}

const { title, url, image, imageAlt, visitLabel, layout = "split" } = Astro.props;
const stacked = layout === "stacked";
---

<article class="card">
  <h3 class="card__title">
    <a href={url}>{title}</a>
  </h3>

  <div class:list={["card__row", { "card__row--stacked": stacked }]}>
    <div class="card__media">
      {image ? (
        <Image
          src={image}
          alt={`${imageAlt}: ${title}`}
          widths={stacked ? [720, 1440] : [420, 840]}
          sizes={stacked ? "(min-width: 800px) 720px, 100vw" : "(min-width: 800px) 420px, 100vw"}
          loading="lazy"
        />
      ) : (
        <p class="card__placeholder">{title}</p>
      )}
    </div>

    <div class="card__text">
      <slot />
      <p class="card__visit"><a href={url}>{visitLabel}</a></p>
    </div>
  </div>
</article>

<style>
  .card + .card {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }

  .card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .card__title a {
    text-decoration: none;
    border-bottom: var(--underline-thickness) solid var(--color-accent);
  }

  .card__row {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .card__media img {
    width: 100%;
    border: var(--border-width) solid var(--color-border);
  }

  .card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    padding: var(--space-5);
    text-align: center;
    font-family: var(--font-title);
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
  }

  .card__text > :global(p) {
    margin-bottom: var(--space-4);
  }

  .card__visit {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  @media (min-width: 800px) {
    .card__row {
      grid-template-columns: 60% 1fr;
    }

    /* One column, so the body keeps a readable measure. */
    .card__row--stacked {
      grid-template-columns: 1fr;
    }
  }

  .card__row--stacked .card__text {
    max-width: 68ch;
  }
</style>
