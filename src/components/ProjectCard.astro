---
import { Image } from "astro:assets";

interface Props {
  title: string;
  url: string;
  /** Where the title links. Defaults to the live site (`url`). */
  href?: string;
  image?: ImageMetadata;
  imageAlt: string;
  visitLabel: string;
  /** Where the visit link goes. Defaults to the live site (`url`). */
  visitHref?: string;
  /**
   * "split" puts the image left and the text right — right for a one-line
   * summary. "stacked" gives both the full column width, which long bodies
   * need: at 40% of the content width the measure drops to ~33 characters.
   * "tile" is the compact summary for a grid (Home): image on top, and the
   * whole card is one link to `href`, so `visitLabel` is plain text.
   */
  layout?: "split" | "stacked" | "tile";
}

const { title, url, href = url, image, imageAlt, visitLabel, visitHref = url, layout = "split" } = Astro.props;
const stacked = layout === "stacked";
const tile = layout === "tile";
---

{tile ? (
  <article class="card card--tile">
    <div class="tile__media">
      {image ? (
        <Image
          src={image}
          alt={`${imageAlt}: ${title}`}
          widths={[420, 840]}
          sizes="(min-width: 1000px) 320px, (min-width: 800px) 30vw, 100vw"
          loading="lazy"
        />
      ) : (
        <p class="card__placeholder">{title}</p>
      )}
    </div>
    <div class="tile__text">
      <h3 class="card__title"><a href={href} class="tile__link">{title}</a></h3>
      <slot />
      <p class="tile__visit">{visitLabel} →</p>
    </div>
  </article>
) : (
<article class="card">
  <h3 class="card__title">
    <a href={href}>{title}</a>
  </h3>

  <div class:list={["card__row", { "card__row--stacked": stacked }]}>
    <div class="card__media">
      {image ? (
        <Image
          src={image}
          alt={`${imageAlt}: ${title}`}
          widths={stacked ? [720, 1440] : [420, 840]}
          sizes={stacked ? "(min-width: 800px) 720px, 100vw" : "(min-width: 800px) 420px, 100vw"}
          loading="lazy"
        />
      ) : (
        <p class="card__placeholder">{title}</p>
      )}
    </div>

    <div class="card__text">
      <slot />
      <p class="card__visit"><a href={visitHref}>{visitLabel}</a></p>
    </div>
  </div>
</article>
)}

<style>
  .card + .card {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }

  .card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .card__title a {
    text-decoration: none;
    border-bottom: var(--underline-thickness) solid var(--color-accent);
  }

  .card__row {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .card__media img {
    width: 100%;
    border: var(--border-width) solid var(--color-border);
  }

  .card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    padding: var(--space-5);
    text-align: center;
    font-family: var(--font-title);
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
  }

  .card__text > :global(p) {
    margin-bottom: var(--space-4);
  }

  .card__visit {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  @media (min-width: 800px) {
    .card__row {
      grid-template-columns: 60% 1fr;
    }

    /* One column, so the body keeps a readable measure. */
    .card__row--stacked {
      grid-template-columns: 1fr;
    }
  }

  .card__row--stacked .card__text {
    max-width: 68ch;
  }

  /* ---------- tile ---------- */
  .card--tile {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--color-border);
  }

  .card + .card--tile,
  .card--tile + .card--tile {
    margin-top: 0;
    padding-top: 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .card--tile:hover {
    background-color: var(--color-accent);
  }

  .card--tile:has(.tile__link:focus-visible) {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .tile__media img,
  .tile__media .card__placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .tile__text {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .tile__text :global(p) {
    font-size: var(--text-sm);
  }

  .card--tile .card__title {
    margin-bottom: 0;
  }

  /* The title link covers the whole card. */
  .tile__link {
    border-bottom: 0;
  }

  .tile__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .tile__link:hover {
    background-color: transparent;
  }

  .tile__visit {
    margin-top: auto;
    font-family: var(--font-title);
    font-size: var(--text-sm);
  }
</style>
