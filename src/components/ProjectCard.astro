---
import { Image } from "astro:assets";

interface Props {
  title: string;
  url: string;
  image?: ImageMetadata;
  imageAlt: string;
  visitLabel: string;
}

const { title, url, image, imageAlt, visitLabel } = Astro.props;
---

<article class="card">
  <h3 class="card__title">
    <a href={url}>{title}</a>
  </h3>

  <div class="card__row">
    <div class="card__media">
      {image ? (
        <Image
          src={image}
          alt={`${imageAlt}: ${title}`}
          widths={[420, 840]}
          sizes="(min-width: 800px) 420px, 100vw"
          loading="lazy"
        />
      ) : (
        <p class="card__placeholder">{title}</p>
      )}
    </div>

    <div class="card__text">
      <slot />
      <p class="card__visit"><a href={url}>{visitLabel}</a></p>
    </div>
  </div>
</article>

<style>
  .card + .card {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }

  .card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .card__title a {
    text-decoration: none;
    border-bottom: var(--underline-thickness) solid var(--color-accent);
  }

  .card__row {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .card__media img {
    width: 100%;
    border: var(--border-width) solid var(--color-border);
  }

  .card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    padding: var(--space-5);
    text-align: center;
    font-family: var(--font-title);
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
  }

  .card__text > :global(p) {
    margin-bottom: var(--space-4);
  }

  .card__visit {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  @media (min-width: 800px) {
    .card__row {
      grid-template-columns: 60% 1fr;
    }
  }
</style>
