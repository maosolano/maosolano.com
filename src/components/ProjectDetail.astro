---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/Prose.astro";
import { useTranslations, routes, projectPath, projectSlug, casePath, showCase, type Lang } from "@/i18n/ui";

interface Props {
  entry: CollectionEntry<"projects">;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, url, image, summary, exploreLabel } = entry.data;
const slug = projectSlug(entry.id);
// getEntry would warn for every project without a case study.
const hasCase = (await getCollection("casos", (e) => e.id === entry.id && showCase(e))).length > 0;
// Temporarily off while the project page structure is reviewed.
const EMBED_CASE = false;
const caseStudy = hasCase && EMBED_CASE ? casePath(lang, slug) : undefined;
---

<Layout
  pageKey="projects"
  title={title}
  description={summary}
  alternates={{ es: projectPath("es", slug), en: projectPath("en", slug) }}
  wide={Boolean(caseStudy)}
>
  <article class="project">
    <header class="project__head">
      <nav class="project__path" aria-label={t("projects.path")}>
        <a href={routes[lang].projects}>{t("projects.title")}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <div class="project__bar">
        <h1>{title}</h1>
        <a class="btn" href={url}>{exploreLabel ?? t("projects.explore")}</a>
      </div>
    </header>

    <div class="project__intro">

      {image && (
        <Image
          class="project__image"
          src={image}
          alt={`${t("projects.imageAlt")}: ${title}`}
          widths={[720, 1440]}
          sizes="(min-width: 800px) 720px, 100vw"
        />
      )}

      <Prose>
        <Content />
      </Prose>
    </div>

    {caseStudy && (
      <iframe
        class="project__case"
        src={caseStudy}
        title={`${title} — ${lang === "es" ? "caso de estudio" : "case study"}`}
        loading="lazy"
      ></iframe>
    )}
  </article>
</Layout>

<style>
  /* With a case study the page goes wide; the text keeps the reading width. */
  .project__intro,
  .project__head {
    max-width: var(--content-max);
  }

  /* Stays under the site bar while the page scrolls. `top` is set from the
     bar's real height by the script below; 64px is the no-JS fallback. */
  .project__head {
    position: sticky;
    top: var(--bar-height, 64px);
    z-index: 50;
    padding: var(--space-3) 0;
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .project__path {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project__path a {
    color: var(--color-text);
  }

  .project__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .project__bar h1 {
    font-size: var(--text-xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-5);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    background-color: var(--color-accent);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius);
  }

  .btn:hover {
    background-color: var(--color-accent-strong);
  }

  .project__intro {
    margin-top: var(--space-6);
  }

  .project__image {
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border: var(--border-width) solid var(--color-border);
  }

  .project :global(.prose) {
    margin-top: var(--space-6);
  }

  /* The case study is its own page and keeps its own look, so it is framed,
     not restyled. It bleeds to the edges of the content area and grows to
     its full height, so the page has a single scroll. */
  .project__case {
    display: block;
    width: calc(100% + 2 * var(--space-4));
    margin: var(--space-7) calc(var(--space-4) * -1) 0;
    height: 100vh;
    border: 0;
    border-top: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 800px) {
    .project__case {
      width: calc(100% + 2 * var(--space-7));
      margin-inline: calc(var(--space-7) * -1);
    }
  }

</style>

<script>
  // Keep the sticky head flush under the site bar, whatever its height.
  const bar = document.querySelector<HTMLElement>(".bar");
  if (bar) {
    const sync = () => document.documentElement.style.setProperty("--bar-height", `${bar.offsetHeight}px`);
    sync();
    new ResizeObserver(sync).observe(bar);
  }

  // Same origin, so the frame can be sized to its document: one scroll for
  // the whole page, and the case study's in-page links scroll this window.
  for (const frame of document.querySelectorAll<HTMLIFrameElement>(".project__case")) {
    const fit = () => {
      const doc = frame.contentDocument;
      if (!doc?.body) return;
      // The body, not the root: the root's scrollHeight never drops below
      // the frame's own height, so it could only ever grow.
      const borders = frame.offsetHeight - frame.clientHeight;
      frame.style.height = `${Math.ceil(doc.body.getBoundingClientRect().height) + borders}px`;
    };

    const wire = () => {
      const doc = frame.contentDocument;
      if (!doc?.body) return;
      fit();
      new ResizeObserver(fit).observe(doc.body);

      doc.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        const target = link && doc.getElementById(link.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        const top = frame.getBoundingClientRect().top + target.getBoundingClientRect().top;
        // On mobile the site bar is sticky and would cover the target.
        const bar = document.querySelector<HTMLElement>(".bar");
        const covered = bar && getComputedStyle(bar).position === "sticky" ? bar.offsetHeight : 0;
        window.scrollTo({ top: window.scrollY + top - covered - 24 });
      });
    };

    frame.addEventListener("load", wire);
    const doc = frame.contentDocument;
    if (doc?.readyState === "complete" && doc.URL !== "about:blank") wire();
  }
</script>
