---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/Prose.astro";
import { useTranslations, routes, projectPath, projectSlug, casePath, showCase, linkAttrs, type Lang } from "@/i18n/ui";

interface Props {
  entry: CollectionEntry<"projects">;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const { title, url, image, summary, exploreLabel } = entry.data;
const slug = projectSlug(entry.id);
// getEntry would warn for every project without a case study.
const hasCase = (await getCollection("casos", (e) => e.id === entry.id && showCase(e))).length > 0;
// Temporarily off while the project page structure is reviewed.
const EMBED_CASE = false;
const caseStudy = hasCase && EMBED_CASE ? casePath(lang, slug) : undefined;
---

<Layout
  pageKey="projects"
  title={title}
  description={summary}
  alternates={{ es: projectPath("es", slug), en: projectPath("en", slug) }}
  wide
>
  <article class="project">
    <header class="project__head">
      <nav class="project__path" aria-label={t("projects.path")}>
        <a href={routes[lang].projects}>{t("projects.title")}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <div class="project__bar">
        <h1>{title}</h1>
        <a class="btn" href={url} {...linkAttrs(url)}>{exploreLabel ?? t("projects.explore")}</a>
      </div>
      <!-- Filled from the page's sections by the script below. -->
      <nav class="project__tabs" aria-label={t("projects.sections")} hidden></nav>
    </header>

    <div class="project__intro">

      {image && (
        <Image
          class="project__image"
          src={image}
          alt={`${t("projects.imageAlt")}: ${title}`}
          widths={[720, 1440]}
          sizes="(min-width: 800px) 720px, 100vw"
        />
      )}

      <Prose>
        <Content />
      </Prose>
    </div>

    {caseStudy && (
      <iframe
        class="project__case"
        src={caseStudy}
        title={`${title} — ${lang === "es" ? "caso de estudio" : "case study"}`}
        loading="lazy"
      ></iframe>
    )}
  </article>
</Layout>

<style>
  /* With a case study the page goes wide; the text keeps the reading width. */
  /* Wide enough for the schemes and screenshots to breathe on desktop, while
     running text keeps its reading width (see Seccion and .project__intro). */
  .project {
    max-width: 1280px;
  }

  /* The MDX holds the sections, so the prose wrapper stays full width and
     only running text is capped. */
  .project :global(.prose) {
    max-width: none;
  }

  .project :global(.prose) > :global(p) {
    max-width: 68ch;
  }

  /* Stays under the site bar while the page scrolls. `top` is set from the
     bar's real height by the script below; 64px is the no-JS fallback. */
  .project__head {
    position: sticky;
    top: var(--bar-height, 64px);
    z-index: 50;
    padding: var(--space-3) 0;
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .project__path {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project__path a {
    color: var(--color-text);
  }

  .project__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .project__tabs {
    display: flex;
    gap: var(--space-1);
    margin: var(--space-2) 0 calc(var(--space-3) * -1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .project__tabs[hidden] {
    display: none;
  }

  .project__tabs :global(a) {
    flex: none;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: var(--underline-thickness) solid transparent;
  }

  .project__tabs :global(a):hover {
    background-color: var(--color-accent);
  }

  .project__tabs :global(a)[aria-current="true"] {
    background-color: var(--color-accent);
    border-bottom-color: var(--color-underline);
    font-weight: var(--weight-medium);
  }

  .project__bar h1 {
    font-size: var(--text-xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-5);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    background-color: var(--color-accent);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius);
  }

  .btn:hover {
    background-color: var(--color-accent-strong);
  }

  .project__intro {
    margin-top: var(--space-6);
  }

  .project__image {
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 1000px) {
    /* The hero image sits beside the intro text; each section clears it. */
    .project__image {
      float: right;
      width: 36%;
      margin: 0 0 var(--space-6) var(--space-7);
    }
  }

  .project :global(.prose) {
    margin-top: var(--space-6);
  }

  /* The case study is its own page and keeps its own look, so it is framed,
     not restyled. It bleeds to the edges of the content area and grows to
     its full height, so the page has a single scroll. */
  .project__case {
    display: block;
    width: calc(100% + 2 * var(--space-4));
    margin: var(--space-7) calc(var(--space-4) * -1) 0;
    height: 100vh;
    border: 0;
    border-top: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 800px) {
    .project__case {
      width: calc(100% + 2 * var(--space-7));
      margin-inline: calc(var(--space-7) * -1);
    }
  }

</style>

<script>
  // Section tabs: built from the page's own sections, so the MDX stays the
  // single source. The current section follows the scroll.
  const head = document.querySelector<HTMLElement>(".project__head");
  const tabs = document.querySelector<HTMLElement>(".project__tabs");
  const sections = [...document.querySelectorAll<HTMLElement>(".seccion")];
  if (head && tabs && sections.length > 1) {
    const links = sections.map((section) => {
      const heading = section.querySelector("h2");
      const link = document.createElement("a");
      link.href = `#${section.id}`;
      link.textContent = heading?.textContent ?? "";
      tabs.append(link);
      return link;
    });
    tabs.hidden = false;

    const syncHead = () => document.documentElement.style.setProperty("--head-height", `${head.offsetHeight}px`);
    syncHead();
    new ResizeObserver(syncHead).observe(head);

    const mark = () => {
      // The last section whose top has passed the line under the sticky head.
      const line = (head.getBoundingClientRect().bottom || 0) + 24;
      let current = 0;
      sections.forEach((section, i) => {
        if (section.getBoundingClientRect().top <= line) current = i;
      });
      // The last section may never reach the line: at the page bottom it is the current one.
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = sections.length - 1;
      links.forEach((link, i) => {
        if (i === current) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
      links[current].scrollIntoView({ block: "nearest", inline: "nearest" });
    };
    addEventListener("scroll", mark, { passive: true });
    mark();
  }

  // Keep the sticky head flush under the site bar, whatever its height.
  const bar = document.querySelector<HTMLElement>(".bar");
  if (bar) {
    const sync = () => document.documentElement.style.setProperty("--bar-height", `${bar.offsetHeight}px`);
    sync();
    new ResizeObserver(sync).observe(bar);
  }

  // Same origin, so the frame can be sized to its document: one scroll for
  // the whole page, and the case study's in-page links scroll this window.
  for (const frame of document.querySelectorAll<HTMLIFrameElement>(".project__case")) {
    const fit = () => {
      const doc = frame.contentDocument;
      if (!doc?.body) return;
      // The body, not the root: the root's scrollHeight never drops below
      // the frame's own height, so it could only ever grow.
      const borders = frame.offsetHeight - frame.clientHeight;
      frame.style.height = `${Math.ceil(doc.body.getBoundingClientRect().height) + borders}px`;
    };

    const wire = () => {
      const doc = frame.contentDocument;
      if (!doc?.body) return;
      fit();
      new ResizeObserver(fit).observe(doc.body);

      doc.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        const target = link && doc.getElementById(link.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        const top = frame.getBoundingClientRect().top + target.getBoundingClientRect().top;
        // On mobile the site bar is sticky and would cover the target.
        const bar = document.querySelector<HTMLElement>(".bar");
        const covered = bar && getComputedStyle(bar).position === "sticky" ? bar.offsetHeight : 0;
        window.scrollTo({ top: window.scrollY + top - covered - 24 });
      });
    };

    frame.addEventListener("load", wire);
    const doc = frame.contentDocument;
    if (doc?.readyState === "complete" && doc.URL !== "about:blank") wire();
  }
</script>
