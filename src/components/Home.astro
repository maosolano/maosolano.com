---
import ProjectCard from "./ProjectCard.astro";
import { getCollection } from "astro:content";
import {
  projectPath,
  projectSlug,
  useTranslations,
  routes,
  intro,
  profile,
  EMAIL,
  LINKEDIN,
  CV_PATH,
  type Lang,
  linkAttrs,
} from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection("projects", ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order
);

const [lead, ...rest] = intro[lang];
const closing = rest.pop();
---

<section class="intro" aria-labelledby="home-heading">
  <h1 id="home-heading">{t("home.heading")}</h1>

  <div class="intro__text">
    <p>{lead}</p>
    {rest.map((paragraph) => <p>{paragraph}</p>)}
    <p><strong>{closing}</strong></p>
  </div>

  <div class="intro__actions">
    <a class="btn btn--primary" href={routes[lang].projects}>{t("home.cta.projects")}</a>
    <a class="btn" href={routes[lang].contact}>{t("home.cta.contact")}</a>
  </div>
</section>

<section class="block" aria-labelledby="featured-heading">
  <h2 id="featured-heading">{t("home.featured")}</h2>
  <div class="grid">
    {projects.map((project) => (
      <ProjectCard
        title={project.data.title}
        url={project.data.url}
        href={projectPath(lang, projectSlug(project.id))}
        image={project.data.image}
        imageAlt={t("projects.imageAlt")}
        visitLabel={t("projects.visit")}
        subtitle={project.data.subtitle}
        layout="tile"
      >
        <p>{project.data.summary}</p>
      </ProjectCard>
    ))}
  </div>
</section>

<section class="block block--text" aria-labelledby="about-heading">
  <h2 id="about-heading">{t("about.title")}</h2>
  <p>{profile[lang][0]}</p>
  <p><a href={routes[lang].about}>{t("home.aboutMore")}</a></p>
</section>

<section class="block block--text" aria-labelledby="contact-heading">
  <h2 id="contact-heading">{t("contact.title")}</h2>
  <ul class="links">
    <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
    <li><a href={LINKEDIN} {...linkAttrs(LINKEDIN)}>LinkedIn</a></li>
    <li><a href={CV_PATH[lang]} {...linkAttrs(CV_PATH[lang])}>{t("about.cv")}</a></li>
  </ul>
</section>

<style>
  .intro h1 {
    margin-bottom: var(--space-5);
  }

  .intro__text {
    max-width: 62ch;
  }

  .intro__text p + p {
    margin-top: var(--space-4);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-5);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius);
  }

  .btn--primary {
    background-color: var(--color-accent);
  }

  .btn:hover {
    background-color: var(--color-accent-strong);
  }

  .block {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border);
  }

  .block h2 {
    margin-bottom: var(--space-6);
  }

  .block--text > :global(p),
  .links {
    max-width: 62ch;
  }

  .block--text p + p {
    margin-top: var(--space-4);
  }

  .links {
    list-style: none;
    padding: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
