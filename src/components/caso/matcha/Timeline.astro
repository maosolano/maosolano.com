---
/** Matcha: the prototype's week, day by day. Key days get a filled dot. */
const days = [
  { when: "12 sep", lead: "Handoff (rev. 3):", text: "flujo, modelo de match, textos y criterios de aceptación." },
  { when: "13–14 sep", lead: "Primeras pantallas", text: "y 4 exploraciones para repartir prioridades." },
  { when: "15 sep", lead: "Cambio de modelo:", text: "el match pasa de rango a suma sobre 100.", key: true },
  { when: "16 sep", lead: "Siempre porcentaje:", text: "se retira el modo de palabras. Publicado en Vercel." },
  { when: "18 sep", lead: "Escala de palabras,", text: "edición en el dato, contacto y links visibles en celular.", key: true },
];
---

<ol class="timeline">
  {days.map((day) => (
    <li class:list={{ key: day.key }}><span class="d">{day.when}</span><p><b>{day.lead}</b> {day.text}</p></li>
  ))}
</ol>

<style>
  .timeline{list-style:none;padding:0;margin:22px 0 0 6px;display:flex;flex-direction:column;border-left:2px solid var(--line);max-width:var(--measure)}
  .timeline li{position:relative;padding:0 0 18px 22px;display:grid;grid-template-columns:78px minmax(0,1fr);gap:4px 14px}
  .timeline li:last-child{padding-bottom:0}
  .timeline li::before{content:"";position:absolute;left:-7px;top:7px;width:12px;height:12px;border-radius:50%;background:var(--bg);border:2px solid var(--line-strong)}
  .timeline li.key::before{background:var(--spot);border-color:var(--accent)}
  .d{font-family:var(--f-mono);font-size:12px;color:var(--faint);padding-top:2px;font-variant-numeric:tabular-nums}
  p{font-size:15px;color:var(--muted)}
  p b{color:var(--ink);font-weight:600}
  @media (max-width:760px){ .timeline li{grid-template-columns:1fr} }
</style>
