---
interface Props {
  items: { name: string; href?: string; when: string; what: string }[];
}

const { items } = Astro.props;
---

<div class="artifacts">
  {items.map((item) => (
    <div class="art">
      {item.href ? (
        <a href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a>
      ) : (
        <span>{item.name}</span>
      )}
      <span class="t">{item.when}</span>
      <span class="d">{item.what}</span>
    </div>
  ))}
</div>
