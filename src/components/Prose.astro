---
/**
 * Wraps rendered Markdown so long-form text keeps a comfortable
 * measure and consistent vertical rhythm. With `lead`, the first
 * paragraph under each heading is set larger, so a section can be
 * scanned by its opening sentences.
 */
interface Props {
  lead?: boolean;
}

const { lead = false } = Astro.props;
---

<div class:list={["prose", { lead }]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 68ch;
  }

  .prose > :global(* + *) {
    margin-top: var(--space-5);
  }

  .prose :global(h2) {
    margin-top: var(--space-7);
  }

  .prose :global(h3) {
    margin-top: var(--space-6);
  }

  /* Opening sentence of each section. Skips paragraphs that only hold an image. */
  .prose.lead :global(:is(h2, h3) + p:not(:has(> img:only-child))) {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .prose :global(img) {
    width: 100%;
    border: var(--border-width) solid var(--color-border);
  }

  .prose :global(figcaption),
  .prose :global(em.caption) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .prose :global(blockquote) {
    padding-left: var(--space-4);
    border-left: var(--underline-thickness) solid var(--color-underline);
    font-weight: var(--weight-medium);
  }

  /* Wide tables scroll inside their own box instead of the page. */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    min-width: 9rem;
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    font-weight: var(--weight-medium);
    border-bottom-color: var(--color-border);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }

  .prose.lead :global(li + li) {
    margin-top: var(--space-2);
  }
</style>
